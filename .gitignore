# Ignore everything in this workspace by default.
/*

# Keep only the project folders we want to version.
# NMC3D/ is no longer a separate tracked project: its unique content now
# lives under orbcalib-master/nmc3d/, so it's a plain local working
# directory here, same as papers/ or gazebo/ -- present on disk, not
# tracked.
!/.gitignore
!/README.md
!/orbcalib-master/

# Local datasets and calibration ground-truth files stay outside Git.
Agilex Recordings/
Finnforest/
gazebo/
papers/

# Ignore heavy/generated outputs inside the kept folders.
orbcalib-master/build/
orbcalib-master/build_*/
orbcalib-master/devel/
orbcalib-master/install/
orbcalib-master/results_*/
orbcalib-master/*results*/
orbcalib-master/*reruns*/
orbcalib-master/good_results_2/
orbcalib-master/nmc3d/results/
orbcalib-master/calib_inliers_*.csv
orbcalib-master/**/*.csv
orbcalib-master/**/*.pdf
orbcalib-master/**/manifest.txt
orbcalib-master/**/SUMMARY.md
orbcalib-master/**/output_*.txt
orbcalib-master/**/*report*.pdf
orbcalib-master/**/*.log
orbcalib-master/**/*.osa
orbcalib-master/**/*atlasCamera*.osa
orbcalib-master/**/*.bag
orbcalib-master/**/*.mcap
orbcalib-master/**/__pycache__/
orbcalib-master/**/*.pyc
orbcalib-master/**/.DS_Store
